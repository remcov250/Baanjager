# Copy to .env (or set these in docker-compose.yml).

# Where the SQLite database lives. The Docker image uses /data.
DATA_DIR=./data

# Default interface language: nl or en. Each browser can override it.
DEFAULT_LOCALE=nl

# Time zone for "found on" defaults, the dashboard greeting and export file names.
TZ=Europe/Amsterdam

# Set to true behind a reverse proxy: login rate limiting then keys on the
# X-Forwarded-For address instead of one shared bucket.
TRUST_PROXY=false

# The session cookie gets the Secure flag when the proxy sends
# X-Forwarded-Proto: https. Set this to true to force it regardless.
COOKIE_SECURE=false

# Optional. Bearer token for the REST API and the MCP server.
# Leave it empty and the API stays switched off.
API_TOKEN=
