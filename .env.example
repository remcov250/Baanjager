# Copy to .env (or set these in docker-compose.yml).

# Where the SQLite database lives. The Docker image uses /data.
DATA_DIR=./data

# Default interface language: nl or en. Each browser can override it.
DEFAULT_LOCALE=nl

# Optional. Set it and the web interface asks for this password.
# Leave it empty when Baanjager is only reachable on your own network or VPN.
APP_PASSWORD=

# Optional. Bearer token for the REST API and the MCP server.
# Leave it empty and the API stays switched off.
API_TOKEN=
